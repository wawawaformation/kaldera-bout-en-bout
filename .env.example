# Application
APP_ENV=development
LOG_LEVEL=INFO

# Partenaire anti-fraude (A2A)
PARTENAIRE_URL=http://localhost:8100
PARTENAIRE_JETON=jeton-de-demo

# LLM (Azure AI — Kimi-K2.6), facultatif
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=Kimi-K2.6
# Modèle du moteur (motif de decision, analyse de la description) : simule (défaut) ou azure
KALDERA_LLM=simule
